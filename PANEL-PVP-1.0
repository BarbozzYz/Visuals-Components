-- Função para atualizar cor
local function UpdateThemeColor(r, g, b)
    Config.ThemeColor = Color3.fromRGB(r, g, b)
    
    -- Atualizar preview
    ColorPreview.BackgroundColor3 = Config.ThemeColor
    
    -- Atualizar hex
    local hex = string.format("#%02X%02X%02X", r, g, b)
    ColorHex.Text = hex
    
    -- Atualizar UI
    Stroke.Color = Config.ThemeColor
    TitlePVP.TextColor3 = Config.ThemeColor
    Content.ScrollBarImageColor3 = Config.ThemeColor
end

-- Drag para Red Slider
local redDragging = false
RedButton.MouseButton1Down:Connect(function()
    redDragging = true
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        redDragging = false
    end
end)

RunService.RenderStepped:Connect(function()
    if redDragging then
        local mousePos = UserInputService:GetMouseLocation()
        local sliderPos = RedSlider.AbsolutePosition
        local sliderSize = RedSlider.AbsoluteSize
        local relativeX = math.clamp(mousePos.X - sliderPos.X, 0, sliderSize.X)
        local percent = relativeX / sliderSize.X
        local value = math.floor(percent * 255)
        
        RedButton.Position = UDim2.new(percent, -8, 0.5, -8)
        RedFill.Size = UDim2.new(percent, 0, 1, 0)
        RedValue.Text = tostring(value)
        
        local g = tonumber(GreenValue.Text)
        local b = tonumber(BlueValue.Text)
        UpdateThemeColor(value, g, b)
    end
end)

-- Drag para Green Slider
local greenDragging = false
GreenButton.MouseButton1Down:Connect(function()
    greenDragging = true
end)

RunService.RenderStepped:Connect(function()
    if greenDragging then
        local mousePos = UserInputService:GetMouseLocation()
        local sliderPos = GreenSlider.AbsolutePosition
        local sliderSize = GreenSlider.AbsoluteSize
        local relativeX = math.clamp(mousePos.X - sliderPos.X, 0, sliderSize.X)
        local percent = relativeX / sliderSize.X
        local value = math.floor(percent * 255)
        
        GreenButton.Position = UDim2.new(percent, -8, 0.5, -8)
        GreenFill.Size = UDim2.new(percent, 0, 1, 0)
        GreenValue.Text = tostring(value)
        
        local r = tonumber(RedValue.Text)
        local b = tonumber(BlueValue.Text)
        UpdateThemeColor(r, value, b)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        greenDragging = false
    end
end)

