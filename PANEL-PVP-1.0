local KeybindBox = Instance.new("TextButton")
KeybindBox.Size = UDim2.new(1, 0, 0, 35)
KeybindBox.Position = UDim2.new(0, 0, 0, 605)
KeybindBox.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
KeybindBox.Text = "  Clique para definir tecla..."
KeybindBox.TextColor3 = Color3.fromRGB(150, 150, 150)
KeybindBox.TextSize = 14
KeybindBox.TextXAlignment = Enum.TextXAlignment.Left
KeybindBox.Font = Enum.Font.Gotham
KeybindBox.Visible = false
KeybindBox.Parent = Content

local KeyCorner = Instance.new("UICorner")
KeyCorner.CornerRadius = UDim.new(0, 6)
KeyCorner.Parent = KeybindBox

TypeDropdown.MouseButton1Click:Connect(function()
    if Config.AimbotMode == "Auto" then
        Config.AimbotMode = "Toggle"
        TypeDropdown.Text = "  Toggle Key"
        KeybindBox.Visible = true
    else
        Config.AimbotMode = "Auto"
        TypeDropdown.Text = "  Auto (Ao Mirar)"
        KeybindBox.Visible = false
    end
end)

local waitingForKey = false
KeybindBox.MouseButton1Click:Connect(function()
    if waitingForKey then return end
    waitingForKey = true
    KeybindBox.Text = "  Aguardando input..."
    KeybindBox.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    
    local connection
    connection = UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Keyboard then
            Config.AimbotKey = input.KeyCode
            Config.AimbotKeyType = "Keyboard"
            KeybindBox.Text = "  "..input.KeyCode.Name
            KeybindBox.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            waitingForKey = false
            connection:Disconnect()
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            Config.AimbotKey = Enum.UserInputType.MouseButton2
            Config.AimbotKeyType = "Mouse"
            KeybindBox.Text = "  Botão Direito do Mouse"
            KeybindBox.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            waitingForKey = false
            connection:Disconnect()
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputState == Enum.UserInputState.Begin then
            local mousePos = UserInputService:GetMouseLocation()
            local guiObjects = game:GetService("CoreGui"):GetGuiObjectsAtPosition(mousePos.X, mousePos.Y)
            local clickedOnButton = false
            for _, obj in pairs(guiObjects) do
                if obj == KeybindBox then
                    clickedOnButton = true
                    break
                end
            end
            
            if not clickedOnButton then
                Config.AimbotKey = Enum.UserInputType.MouseButton1
                Config.AimbotKeyType = "Mouse"
                KeybindBox.Text = "  Botão Esquerdo do Mouse"
                KeybindBox.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
                waitingForKey = false
                connection:Disconnect()
            end
        end
    end)
end)

