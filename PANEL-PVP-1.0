local dropOpen = false
DropdownBtn.MouseButton1Click:Connect(function()
    dropOpen = not dropOpen
    if dropOpen then
        DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 75), "Out", "Quad", 0.2, true)
    else
        DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 0), "Out", "Quad", 0.2, true)
    end
end)

local function CreateDropOption(text, position)
    local Opt = Instance.new("TextButton")
    Opt.Size = UDim2.new(1, -10, 0, 32)
    Opt.Position = position
    Opt.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    Opt.Text = text
    Opt.TextColor3 = Color3.fromRGB(220, 220, 220)
    Opt.TextSize = 14
    Opt.Font = Enum.Font.Gotham
    Opt.Parent = DropdownContainer
    
    local OptCorner = Instance.new("UICorner")
    OptCorner.CornerRadius = UDim.new(0, 4)
    OptCorner.Parent = Opt
    
    Opt.MouseButton1Click:Connect(function()
        Config.AimbotPart = text
        DropdownBtn.Text = "  "..text
        DropdownContainer:TweenSize(UDim2.new(1, 0, 0, 0), "Out", "Quad", 0.2, true)
        dropOpen = false
    end)
end

CreateDropOption("Head", UDim2.new(0, 5, 0, 5))
